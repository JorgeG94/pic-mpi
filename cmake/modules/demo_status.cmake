function(print_summary)
  # Which backend pic_mpi_lib selects, the same order src/CMakeLists.txt checks
  # them in.
  if(NOT PIC_ENABLE_MPI)
    set(_backend "serial (single rank, no MPI)")
  elseif(PIC_USE_LEGACY_MPI)
    set(_backend "legacy mpi module")
  elseif(PIC_USE_VAPAA)
    set(_backend "mpi_f08 via vapaa")
  else()
    set(_backend "mpi_f08")
  endif()
  message(STATUS "")
  message(STATUS "========== ${project_name} Configuration Summary ==========")
  message(STATUS "  Version               : ${PROJECT_VERSION}")
  message(STATUS "  Fortran compiler      : ${CMAKE_Fortran_COMPILER_ID}")
  message(STATUS "  MPI backend           : ${_backend}")
  message(STATUS "  PIC_ENABLE_MPI        : ${PIC_ENABLE_MPI}")
  message(STATUS "  PIC_USE_LEGACY_MPI    : ${PIC_USE_LEGACY_MPI}")
  message(STATUS "  PIC_MPICH_PERLMUTTER  : ${PIC_MPICH_PERLMUTTER}")
  message(STATUS "  ENABLE_TESTING        : ${ENABLE_TESTING}")
  message(STATUS "===============================================")
endfunction()
